{
  "name": "muse-cart-showroom",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "vite build && WRANGLER_SEND_METRICS=false wrangler dev --env local --local --ip 127.0.0.1 --port 8877 --inspector-port 0 --persist-to .local/state",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:persist": "node scripts/verify-persist.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
